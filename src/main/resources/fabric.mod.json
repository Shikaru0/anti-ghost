{
	"schemaVersion": 1,
	"id": "anti-ghost",
	"version": "${version}",
	"name": "anti-ghost",
	"description": "Automatically re-updates your inventory in an attempt to prevent / minimize ghosting | Unofficial continuation by Shikaru0",
	"authors": [
		"TheMasterKitty",
		"Shikaru0"
	],
	"contact": {
		"homepage": "https://github.com/Shikaru0/",
		"sources": "https://github.com/Shikaru0/anti-ghost/tree/fabric-26.1.2"
	},
	"license": "MIT",
	"icon": "assets/anti-ghost/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"name.modid.AntiGhost"
		],
		"client": [
			"name.modid.client.AntiGhostClient"
		]
	},
	"mixins": [
		"anti-ghost.mixins.json",
		{
			"config": "anti-ghost.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": "*",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}